{
  "name": "valentine-heart",
  "private": true,
  "version": "2.0.0",
  "description": "A heart made of light: stardust that gathers into a beating 3D heart, bursts when love is sent and writes a name in particles.",
  "license": "UNLICENSED",
  "repository": "github:Perceval-Wilhelm/valentine-heart",
  "type": "module",
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "yarn runtime:check && next dev",
    "build": "yarn runtime:check && next build",
    "start": "yarn runtime:check && next start",
    "type-check": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "yarn runtime:check && yarn format:check && yarn lint && yarn type-check && yarn test && yarn test:tooling",
    "check:all": "yarn check && yarn build",
    "runtime:check": "node scripts/check-runtime.mjs",
    "test:tooling": "node --test scripts/lint.test.mjs scripts/smoke.test.mjs",
    "test:e2e": "yarn runtime:check && playwright test",
    "test:e2e:ui": "yarn runtime:check && playwright test --ui",
    "smoke": "node scripts/smoke.mjs",
    "verify": "yarn check:all && yarn test:e2e"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-react/eslint-plugin": "5.28.8",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.3",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "31.0.0",
    "playwright-core": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependenciesMeta": {
    "unrs-resolver": {
      "built": true
    }
  }
}
